{
  "name": "robinhood-gainloss",
  "version": "0.0.6",
  "description": "Robinhood Trading Gain/Loss Calculator",
  "author": "Artiom Baloian <artiom.baloian@gmail.com>",
  "main": "dist/robinhood-gainloss.js",
  "types": "dist/robinhood-gainloss.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepare": "npm run build",
    "start": "tsc && NODE_ENV=${NODE_ENV-production} node dist/main.js",
    "dev": "tsc && NODE_ENV=${NODE_ENV-development} node dist/main.js",
    "test": "rm -rf dist && tsc && jest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baloian/robinhood-gainloss.git"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "fs": "^0.0.1-security",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript-ds-lib": "^0.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/msgpack5": "^3.4.3",
    "@types/node": "^22.8.6",
    "@types/readable-stream": "^4.0.2",
    "@types/ws": "^8.5.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
